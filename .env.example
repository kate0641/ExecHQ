# ExecHQ prototype — local settings.
#
# Copy this file to .env.local (same folder) and leave it as it is:
#
#   cp .env.example .env.local
#
# Nothing in here is secret. The prototype has no login, no database and no
# network calls, so there are no keys to fill in.

# Opens the showroom at http://localhost:3000/showroom — the design system, the
# component catalogue and the playground. It has no effect on the public site,
# which never builds the showroom whatever this says.
SHOWROOM=on
